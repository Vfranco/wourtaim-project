{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "strict": true, //banderas
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
    },
    "include": [
        "src",
        "tests",
        "vite.config.ts"
    ]
}