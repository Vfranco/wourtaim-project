#!/usr/bin/env sh
#
# main y develop están protegidas: nadie commitea ahí directamente.
# El trabajo sale de develop en una rama y vuelve por Pull Request.

rama=$(git rev-parse --abbrev-ref HEAD)

case "$rama" in
  main|develop)
    echo ""
    echo "  Estás en '$rama', que es una rama protegida."
    echo ""
    echo "  Saca tu rama y commitea ahí:"
    echo "    git checkout -b feature/<historia> develop"
    echo ""
    exit 1
    ;;
esac
